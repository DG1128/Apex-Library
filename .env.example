# ==============================================================================
# Apex LMS - Environment Configuration Template
# Copy this file to .env and configure values before starting the server.
# ==============================================================================

# Network Port (Default: 3000)
# Port on which the HTTP web application and API will listen
PORT=3000

# Server Host Binding (0.0.0.0 enables access from local machine and college LAN)
HOST=0.0.0.0

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret Key
# IMPORTANT: Change this to a high-entropy cryptographically random string in production!
JWT_SECRET=apex-library-ultra-secure-jwt-secret-key-replace-in-production-2024

# JWT Token Expiry (e.g., '12h', '24h', '7d')
JWT_EXPIRES_IN=12h

# Database Path (Relative to project root)
# The file will be auto-created if it does not exist.
DB_PATH=./data/library.db

# Automated Hot Backup Directory
BACKUP_DIR=./backups

# Fine & Loan Default Fallbacks (Overridden by database settings table)
DEFAULT_LOAN_DAYS_STUDENT=14
DEFAULT_LOAN_DAYS_FACULTY=30
DEFAULT_FINE_RATE_PER_DAY=2.00
